{
  "name": "pollyroll",
  "version": "0.1.0",
  "description": "Lightweight, zero-dependency 3D dice for the web: WebGL2 renderer, deterministic physics, result-first rolls for multiplayer.",
  "license": "MIT",
  "author": "IrakliDevelop",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/IrakliDevelop/pollyroll.git"
  },
  "keywords": [
    "dice",
    "3d",
    "webgl",
    "webgl2",
    "rpg",
    "dnd",
    "dice-roller"
  ],
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./render": {
      "import": {
        "types": "./dist/render.d.ts",
        "default": "./dist/render.js"
      },
      "require": {
        "types": "./dist/render.d.cts",
        "default": "./dist/render.cjs"
      }
    },
    "./react": {
      "import": {
        "types": "./dist/react.d.ts",
        "default": "./dist/react.js"
      },
      "require": {
        "types": "./dist/react.d.cts",
        "default": "./dist/react.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "engines": {
    "node": ">=20.19"
  },
  "packageManager": "pnpm@10.28.0",
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "bench": "vitest bench --run",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "size": "size-limit",
    "e2e": "playwright test",
    "agent:check": "node scripts/check-agent-docs.mjs",
    "dev": "vite --config demo/vite.config.ts",
    "verify": "pnpm agent:check && pnpm lint && pnpm format:check && pnpm build && pnpm typecheck && pnpm test:coverage && pnpm size",
    "prepare": "husky"
  },
  "peerDependencies": {
    "react": ">=18"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@playwright/test": "1.56.1",
    "@size-limit/preset-small-lib": "^12.1.0",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitest/coverage-v8": "^4.1.11",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "husky": "^9.1.7",
    "jsdom": "^27.4.0",
    "lint-staged": "^16.4.0",
    "prettier": "^3.9.9",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "size-limit": "^12.1.0",
    "tsup": "^8.5.1",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.71.1",
    "vite": "^7.3.6",
    "vitest": "^4.1.11"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{js,mjs,json,md,yml,yaml,html,css}": "prettier --write"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
